[Unit]
Description=Kalshi LIP recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lip
WorkingDirectory=/opt/kalshi-lip-recorder
# Optional read-only API key: KALSHI_KEY_ID=... and KALSHI_PRIVATE_KEY_PATH=/etc/lip/key.pem (chmod 600, owned by lip)
EnvironmentFile=-/etc/lip/recorder.env
ExecStart=/opt/kalshi-lip-recorder/.venv/bin/python -m lip.recorder --out /var/lib/lip --markets 150 --interval 300
Restart=always
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lip
PrivateTmp=true

[Install]
WantedBy=multi-user.target
